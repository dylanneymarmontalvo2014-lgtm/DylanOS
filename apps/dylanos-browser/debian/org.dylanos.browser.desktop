[Desktop Entry]
Type=Application
Version=1.0
Name=DylanOS Browser
GenericName=Web Browser
Comment=Browse the web with DylanOS Browser
Exec=dylanos-browser %U
Icon=dylanos-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=dylanos-browser
Actions=new-window;private-window;

[Desktop Action new-window]
Name=New Window
Exec=dylanos-browser

[Desktop Action private-window]
Name=New Private Window
Exec=dylanos-browser --private-window
