{
  "_comentario": [
    "Catálogo del DylanOS Login Manager: atajos y widgets disponibles en el",
    "login. Cada entrada declara de dónde salen sus datos. Un elemento sin",
    "fuente real no se ofrece: no hay widgets ni atajos simulados.",
    "El usuario elige 4 atajos como máximo (el límite del prototipo) y los",
    "widgets que quiera de cada columna."
  ],
  "version": 1,
  "atajos": [
    {
      "id": "tema",
      "nombre": "Modo oscuro",
      "descripcion": "Alterna entre la apariencia clara y la oscura.",
      "fuente": "preferencia del usuario",
      "accion": "local"
    },
    {
      "id": "no-molestar",
      "nombre": "No molestar",
      "descripcion": "Silencia las notificaciones de la sesión que va a iniciar.",
      "fuente": "preferencia del usuario",
      "accion": "local"
    },
    {
      "id": "wifi",
      "nombre": "Wi-Fi",
      "descripcion": "Enciende o apaga la radio Wi-Fi del equipo.",
      "fuente": "NetworkManager (helper privilegiado)",
      "accion": "red"
    },
    {
      "id": "bluetooth",
      "nombre": "Bluetooth",
      "descripcion": "Enciende o apaga el adaptador Bluetooth.",
      "fuente": "BlueZ (helper privilegiado)",
      "accion": "red"
    },
    {
      "id": "apagar",
      "nombre": "Apagar",
      "descripcion": "Apaga el equipo desde el propio login.",
      "fuente": "SDDM (canPowerOff)",
      "accion": "energia"
    },
    {
      "id": "reiniciar",
      "nombre": "Reiniciar",
      "descripcion": "Reinicia el equipo desde el propio login.",
      "fuente": "SDDM (canReboot)",
      "accion": "energia"
    },
    {
      "id": "suspender",
      "nombre": "Suspender",
      "descripcion": "Suspende el equipo sin iniciar sesión.",
      "fuente": "SDDM (canSuspend)",
      "accion": "energia"
    },
    {
      "id": "sesion",
      "nombre": "Sesión",
      "descripcion": "Elige la sesión de escritorio que se iniciará.",
      "fuente": "sesiones instaladas",
      "accion": "local"
    },
    {
      "id": "teclado",
      "nombre": "Teclado",
      "descripcion": "Muestra la distribución de teclado activa.",
      "fuente": "/etc/default/keyboard",
      "accion": "local"
    },
    {
      "id": "contraste",
      "nombre": "Contraste",
      "descripcion": "Activa el modo de alto contraste del login.",
      "fuente": "preferencia del usuario",
      "accion": "local"
    },
    {
      "id": "texto",
      "nombre": "Texto",
      "descripcion": "Aumenta el tamaño del texto del login.",
      "fuente": "preferencia del usuario",
      "accion": "local"
    },
    {
      "id": "crimson-glass",
      "nombre": "Crimson Glass",
      "descripcion": "Enciende o apaga el desenfoque de cristal del login.",
      "fuente": "preferencia del usuario",
      "accion": "local"
    }
  ],
  "widgets": [
    {
      "id": "clima",
      "nombre": "Clima",
      "columna": "izquierda",
      "fuente": "open-meteo (abierto, sin clave)",
      "requiere": "latitud y longitud en la configuración",
      "nota": "Se consulta con caché de 30 min; sin red se usa el último dato bueno. Sin ubicación configurada no se muestra."
    },
    {
      "id": "proximo-evento",
      "nombre": "Próximo evento",
      "columna": "izquierda",
      "fuente": "calendario .ics indicado en la configuración",
      "requiere": "ruta a un .ics local",
      "nota": "Sin fichero .ics no se muestra: el login no tiene calendario de sistema."
    },
    {
      "id": "reproduccion",
      "nombre": "En reproducción",
      "columna": "izquierda",
      "fuente": "reproductor MPRIS activo",
      "requiere": "reproductor en ejecución",
      "nota": "Antes de iniciar sesión no hay reproductor: se oculta."
    },
    {
      "id": "sistema",
      "nombre": "Sistema",
      "columna": "izquierda",
      "fuente": "/sys/class/power_supply y statvfs",
      "requiere": "batería o disco montado",
      "nota": "Muestra solo lo que existe: sin batería no hay anillo de carga."
    },
    {
      "id": "usuarios",
      "nombre": "Usuarios",
      "columna": "izquierda",
      "fuente": "cuentas con sesión del sistema",
      "requiere": "más de una cuenta",
      "nota": "Permite cambiar de usuario sin escribir el nombre."
    },
    {
      "id": "sesiones",
      "nombre": "Sesiones",
      "columna": "izquierda",
      "fuente": "/usr/share/xsessions y wayland-sessions",
      "requiere": "más de una sesión instalada",
      "nota": "Lista real de escritorios instalados."
    },
    {
      "id": "teclado",
      "nombre": "Teclado",
      "columna": "izquierda",
      "fuente": "/etc/default/keyboard",
      "requiere": "distribución configurada",
      "nota": "Solo lectura: la distribución se cambia en el inicio de sesión."
    },
    {
      "id": "calendario",
      "nombre": "Calendario",
      "columna": "derecha",
      "fuente": "reloj del sistema",
      "requiere": "ninguno",
      "nota": "Mes y día reales, calculados en el momento."
    },
    {
      "id": "recordatorios",
      "nombre": "Recordatorios",
      "columna": "derecha",
      "fuente": "lista en /etc/dylanos/login-manager.json",
      "requiere": "recordatorios guardados",
      "nota": "Los define la configuración del login; máximo cuatro, como el prototipo."
    },
    {
      "id": "atajos",
      "nombre": "Atajos",
      "columna": "derecha",
      "fuente": "selección del usuario",
      "requiere": "al menos un atajo activo",
      "nota": "Cuatro como máximo, igual que el prototipo."
    },
    {
      "id": "energia",
      "nombre": "Energía",
      "columna": "derecha",
      "fuente": "capacidades de SDDM",
      "requiere": "sistema con energía gestionada",
      "nota": "Apagar, reiniciar y suspender solo si SDDM los permite."
    },
    {
      "id": "version",
      "nombre": "Versión del sistema",
      "columna": "derecha",
      "fuente": "/etc/dylanos-release",
      "requiere": "ninguno",
      "nota": "Nombre y versión reales de la distribución."
    },
    {
      "id": "mensaje",
      "nombre": "Mensaje del administrador",
      "columna": "derecha",
      "fuente": "/etc/dylanos/login-manager.json",
      "requiere": "mensaje configurado",
      "nota": "Aviso dirigido a todas las cuentas o a una concreta."
    },
    {
      "id": "reloj-mundial",
      "nombre": "Reloj mundial",
      "columna": "derecha",
      "fuente": "zonas horarias del sistema",
      "requiere": "zonas configuradas",
      "nota": "Horas reales de las zonas elegidas."
    }
  ]
}
