# Branding de DylanOS para el instalador Calamares.
# Identidad Crimson: negro (#0A0A0A) + crimson (#DC143C), sin live preview:
# la ISO arranca directo al instalador a pantalla completa.
---
componentName: dylanos

### WELCOME / OVERALL WORDING
welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

### WINDOW CONFIGURATION
# A pantalla completa: la ISO es solo instalador.
windowExpanding:         fullscreen
windowPlacement:          center

### PANELS CONFIGURATION
sidebar:                  widget
navigation:               widget

### STRINGS, IMAGES AND COLORS
strings:
    productName:         DylanOS
    shortProductName:    DylanOS
    version:             1.0 Beta
    shortVersion:        1.0
    versionedName:       DylanOS 1.0 Beta
    shortVersionedName:   DylanOS 1.0
    bootloaderEntryName: DylanOS
    productUrl:          https://github.com/dylanneymarmontalvo2014-lgtm/DylanOS
    supportUrl:          https://github.com/dylanneymarmontalvo2014-lgtm/DylanOS/issues
    knownIssuesUrl:      https://github.com/dylanneymarmontalvo2014-lgtm/DylanOS/issues
    releaseNotesUrl:     https://github.com/dylanneymarmontalvo2014-lgtm/DylanOS/releases
    donateUrl:           ""

images:
    productIcon:         "logo.png"
    productLogo:         "logo.png"
    productWelcome:      "background.png"

style:
    SidebarBackground:        "#0A0A0A"
    SidebarText:              "#98989F"
    SidebarTextCurrent:       "#F5F5F7"
    SidebarBackgroundCurrent: "#DC143C"

### SLIDESHOW
slideshow:                "show.qml"
slideshowAPI:             2

### LOG UPLOAD
uploadServer:
    type:                 "none"
