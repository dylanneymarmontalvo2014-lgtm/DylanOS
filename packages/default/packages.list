# DylanOS — paquetes del sistema base
# Un paquete por línea. '#' inicia un comentario.

# Núcleo e init
linux-image-amd64
systemd-sysv

# Escritorio KDE Plasma
kde-plasma-desktop
sddm
# El único gestor de archivos es DylanOS Explorer (apps/dylanos-explorer,
# motor KIO de Dolphin); el paquete dolphin ya no se envía.
# kcalc tampoco: la calculadora oficial es la nativa dylanos-calculator.
# La terminal oficial es DylanOS Console (Kitty); konsole no se envía.
kitty
systemsettings

# Instalador propio DylanOS (dylanos-installer)
parted
squashfs-tools

# Sistema
sudo
network-manager
ca-certificates
locales
live-boot
live-config
live-config-systemd
live-tools
initramfs-tools
grub-pc-bin
grub-efi-amd64-bin
grub2-common
efibootmgr
dosfstools
cryptsetup-initramfs
x11-xserver-utils
os-prober
plymouth
plymouth-themes
fonts-inter
fonts-jetbrains-mono
# Terminal DylanOS: Kitty + neofetch con logo PNG (icat requiere ImageMagick)
imagemagick
neowofetch
breeze-icon-theme
kde-style-breeze
breeze-gtk-theme
kde-config-gtk-style
gsettings-desktop-schemas
kwin-addons
plasma-nm
plasma-pa
powerdevil
# Backend requerido por DylanOS Configuration para perfiles de energía.
power-profiles-daemon
bluedevil
bluez
pipewire-audio
playerctl
# La tienda es la app propia dylanos-store (compilada en build.sh).
# Runtime del fork (libdiscover + backend PackageKit/Flatpak):
appstream
libpackagekitqt6-1
flatpak
packagekit
plasma-systemmonitor
kde-spectacle
kscreen
kio-extras
xdg-desktop-portal-kde
xdg-user-dirs
polkit-kde-agent-1
python3-pyside6.qtcore
python3-pyside6.qtgui
python3-pyside6.qtqml
python3-pyside6.qtquick
python3-pyside6.qtquickcontrols2
# Instalador nativo: ventana Qt WebEngine propia (sin navegador externo)
python3-pyside6.qtwidgets
python3-pyside6.qtwebenginecore
python3-pyside6.qtwebenginewidgets
python3-psutil
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtquick-templates
qml6-module-qtqml-workerscript
