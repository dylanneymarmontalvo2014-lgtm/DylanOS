# DylanOS — paquetes del sistema base
# Un paquete por línea. '#' inicia un comentario.

# Núcleo e init
linux-image-amd64
systemd-sysv

# Escritorio KDE Plasma
kde-plasma-desktop
sddm
# El único gestor de archivos es DylanOS Explorer (apps/dylanos-explorer,
# motor KIO de Dolphin); el paquete dolphin ya no se envía.
# kcalc tampoco: la calculadora oficial es la nativa dylanos-calculator.
# La terminal oficial es DylanOS Console (Kitty); konsole no se envía.
kitty
systemsettings
# DylanOS Configuration abre sus controles de KDE con kcmshell6, que NO lo
# aporta systemsettings: viene del paquete libkf6kcmutils-bin. Sin él, todas
# las acciones System.openKcm() fallaban con «No hay kcmshell disponible» y la
# configuración del sistema se quedaba sin efecto.
libkf6kcmutils-bin

# Instalador propio DylanOS (dylanos-installer)
parted
squashfs-tools

# Sistema
sudo
network-manager
ca-certificates
locales
live-boot
live-config
live-config-systemd
live-tools
initramfs-tools
# zstd: initramfs-tools-core solo lo recomienda; sin el binario update-initramfs
# genera el initrd en gzip en vez de zstd.
zstd
# console-setup: provee setupcon, que live-boot usa al aplicar
# keyboard-layouts=latam; sin él el TTY live queda sin layout.
console-setup
grub-pc-bin
grub-efi-amd64-bin
grub2-common
efibootmgr
dosfstools
cryptsetup-initramfs
x11-xserver-utils
os-prober
plymouth
plymouth-themes
fonts-inter
fonts-jetbrains-mono
# Terminal DylanOS: Kitty + neofetch con logo PNG (icat requiere ImageMagick)
imagemagick
neowofetch
breeze-icon-theme
papirus-icon-theme
kde-style-breeze
breeze-gtk-theme
kde-config-gtk-style
gsettings-desktop-schemas
kwin-addons
plasma-nm
plasma-pa
powerdevil
# Backend requerido por DylanOS Configuration para perfiles de energía.
power-profiles-daemon
bluedevil
bluez
pipewire-audio
# pactl (PulseAudio/PipeWire) es el backend de sonido real que consumen
# SystemService, el Centro de Control y la página de sonido.
pulseaudio-utils
playerctl
# La tienda es la app propia dylanos-store (compilada en build.sh).
# Runtime del fork (libdiscover + backend PackageKit/Flatpak):
appstream
libpackagekitqt6-1
flatpak
packagekit
plasma-systemmonitor
kde-spectacle
kscreen
kio-extras
xdg-desktop-portal-kde
xdg-user-dirs
polkit-kde-agent-1
python3-pyside6.qtcore
python3-pyside6.qtgui
python3-pyside6.qtqml
python3-pyside6.qtquick
python3-pyside6.qtquickcontrols2
# Instalador nativo: ventana Qt WebEngine propia (sin navegador externo)
python3-pyside6.qtwidgets
python3-pyside6.qtwebenginecore
python3-pyside6.qtwebenginewidgets
python3-psutil
qml6-module-qtquick
qml6-module-qtquick-controls
# DylanOS Explorer importa QtQuick.Shapes; quitar el módulo impide crear la ventana QML.
qml6-module-qtquick-shapes
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtquick-templates
qml6-module-qtqml-workerscript
qml6-module-qtcore
qml6-module-org-kde-plasma-plasma5support
# Widget de Fotos de DylanOS Widgets: FolderListModel para leer la carpeta local.
# (Portapapeles usa xclip en X11; el historial requiere klipper o cliphist, que
# no se envían: el widget declara ese límite en lugar de simularlo.)
qml6-module-qt-labs-folderlistmodel
xclip
qdbus-qt6

# Aplicaciones predeterminadas (espejo de configs/default-apps.conf)
# El navegador predeterminado es Firefox ESR mientras DylanOS Browser no
# tenga un payload verificado; build.sh solo empaqueta el Browser si existe.
firefox-esr
kate
vlc
gwenview
ark
okular
libreoffice
elisa
kamoso
partitionmanager
kup-backup
thunderbird
firmware-linux-free
firmware-iwlwifi
firmware-realtek
firmware-amd-graphics
firmware-intel-graphics
libqt6sql6-sqlite
