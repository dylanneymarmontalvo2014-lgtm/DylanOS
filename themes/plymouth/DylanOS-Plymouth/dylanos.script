Window.SetBackgroundTopColor(0.06, 0.07, 0.11);
Window.SetBackgroundBottomColor(0.12, 0.08, 0.14);
logo.image = Image.Text("DylanOS", 0.96, 0.96, 0.98);
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Window.GetWidth() / 2 - logo.image.GetWidth() / 2, Window.GetHeight() / 2 - 30, 1);
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.8, 0.8, 0.86);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Window.GetWidth() / 2 - message.image.GetWidth() / 2, Window.GetHeight() / 2 + 35, 1);
}
fun password_callback(prompt, bullets) {
    text = prompt + " ";
    for (i = 0; i < bullets; i++) text += "*";
    message_callback(text);
}
fun question_callback(prompt, entry) { message_callback(prompt + " " + entry); }
fun normal_callback() { message_callback(""); }
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetMessageFunction(message_callback);
